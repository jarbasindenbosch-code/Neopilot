{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/AAD_TENANT_ID/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    { "route": "/login", "redirect": "/.auth/login/aad" },
    { "route": "/logout", "redirect": "/.auth/logout" },

    { "route": "/leerling/*", "allowedRoles": ["leerling"] },
    { "route": "/docent/*",   "allowedRoles": ["docent", "admin"] },
    { "route": "/admin/*",    "allowedRoles": ["admin"] },

    { "route": "/api/voortgang", "allowedRoles": ["leerling", "docent", "admin"] },
    { "route": "/api/klassen",   "allowedRoles": ["docent", "admin"] },
    { "route": "/api/GetRoles",  "allowedRoles": ["anonymous", "authenticated"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/aad" },
    "403": { "rewrite": "/geen-toegang.html" }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "*.{png,jpg,webp,css,js,ico}"]
  }
}
